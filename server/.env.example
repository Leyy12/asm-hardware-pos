# =============================================
# ASM BACKEND ENVIRONMENT — EXAMPLE TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).
# =============================================

# URL of the InventaAPI instance (no trailing slash)
INVENTA_API_URL=https://inventaapi.shop

# Secret API key issued by InventaAPI. It decides which products come back,
# so use the Hardware API key for ASM.
INVENTA_API_KEY=

# Port for this backend server
PORT=3002

# CORS origin — Vite dev server URL (update for production)
ALLOWED_ORIGIN=http://localhost:5173
