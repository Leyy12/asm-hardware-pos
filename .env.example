# =============================================================================
# ASM settings: the ONLY env file this project needs.
#
# For local testing: copy this file to ".env" in the same folder (the project
# root, next to package.json), fill in the values, then run `npm run dev`.
# Restart `npm run dev` after changing anything here.
#
# ".env" is in .gitignore, so your real keys never go to GitHub.
# On the live site (Vercel), set the same names under
# Project → Settings → Environment Variables. Vercel never reads this file.
# =============================================================================


# ── InventaAPI (product catalog) ─────────────────────────────────────────────
# One key per segment. Get each key from inventaapi.shop → API Keys → Copy.
# Leave a line empty if you don't use that segment.
# These are read only on the server side; they are never sent to the browser.
INVENTA_API_KEY_HARDWARE=
INVENTA_API_KEY_GROCERY=
INVENTA_API_KEY_PHARMACY=

# Where InventaAPI lives (no trailing slash). Leave as is.
INVENTA_API_URL=https://inventaapi.shop


# ── Firebase (login, products, sales) ────────────────────────────────────────
# From Firebase console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ── Chatbot (NVIDIA) ─────────────────────────────────────────────────────────
# Note: anything starting with VITE_ is built into the website and visible to
# visitors in the browser.
VITE_NVIDIA_API_KEY=
